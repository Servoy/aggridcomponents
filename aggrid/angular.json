{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "cli": {
    "analytics": "c73821cc-c3cd-481c-a275-0657b4a6c943"
  },
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "@servoy/nggrids": {
      "projectType": "library",
      "root": "projects/nggrids",
      "sourceRoot": "projects/nggrids/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "options": {
            "tsConfig": "projects/nggrids/tsconfig.lib.json",
            "project": "projects/nggrids/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/nggrids/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/nggrids/tsconfig.lib.json"
            }
          }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/nggrids/tsconfig.spec.json",
            "buildTarget": "@servoy/nggrids:build:development",
            "include": ["**/*.spec.ts"],
            "exclude": ["**/*.browser.spec.ts"]
          }
        },
        "test-browser": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/nggrids/tsconfig.spec-browser.json",
            "buildTarget": "@servoy/nggrids:build:development",
            "browsers": ["chromium"],
            "headless": true,
            "include": ["projects/nggrids/src/**/*.browser.spec.ts"]
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "projects/nggrids/src/**/*.ts",
              "projects/nggrids/src/**/*.html"
            ]
          }
        }
      }
    },
    "dummy": {
      "projectType": "application",
      "root": "projects/dummy",
      "sourceRoot": "projects/dummy/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/dummy",
            "index": "projects/dummy/src/index.html",
            "browser": "projects/dummy/src/main.ts",
            "polyfills": [],
            "tsConfig": "projects/dummy/tsconfig.app.json",
            "styles": [
              "projects/dummy/src/styles.css"
            ],
            "scripts": []
          }
        }
      }
    }
  },
  "schematics": {
    "@schematics/angular:component": {
      "type": "component"
    },
    "@schematics/angular:directive": {
      "type": "directive"
    },
    "@schematics/angular:service": {
      "type": "service"
    },
    "@schematics/angular:guard": {
      "typeSeparator": "."
    },
    "@schematics/angular:interceptor": {
      "typeSeparator": "."
    },
    "@schematics/angular:module": {
      "typeSeparator": "."
    },
    "@schematics/angular:pipe": {
      "typeSeparator": "."
    },
    "@schematics/angular:resolver": {
      "typeSeparator": "."
    }
  }
}
